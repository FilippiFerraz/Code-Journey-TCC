generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                Int       @id @default(autoincrement())
  nome              String
  email             String    @unique
  senha             String
  // Opcional no banco pra não quebrar as contas já cadastradas antes desse
  // campo existir — mas obrigatória no cadastro novo (ver auth.service.js).
  idade             Int?
  codigoRecuperacao String?
  codigoExpiraEm    DateTime?
  criadoEm          DateTime  @default(now())

  // Confirmação de e-mail no cadastro (campos separados dos de recuperação
  // de senha acima, pra um fluxo nunca sobrescrever o código do outro).
  // Login é bloqueado enquanto emailVerificado for false — ver auth.service.js.
  emailVerificado           Boolean   @default(false)
  codigoVerificacao         String?
  codigoVerificacaoExpiraEm DateTime?

  // Cache do XP total do jogador, pra não ter que somar Progresso.xpGanho
  // toda vez que a tela de Perfil/Ranking precisar mostrar o total.
  // Coluna nova (ADD COLUMN), não afeta as linhas existentes — todo mundo
  // começa com 0.
  xpTotal Int @default(0)

  // Marca se o jogador já viu o tutorial guiado da Home (portais, perfil,
  // ranking, configurações). Ver TutorialHome.jsx / POST /api/perfil/tutorial-visto.
  tutorialVisto Boolean @default(false)

  // "jogador" | "administrador". Administradores acessam rotas protegidas
  // por verificarAdmin (ver middlewares/admin.middleware.js) — dashboard de
  // suporte, edição de desafios, etc. Hoje não existe UI pra promover um
  // usuário; faça isso direto no banco (SQL Editor do Neon ou Prisma Studio):
  // UPDATE usuarios SET role = 'administrador' WHERE email = '...';
  role String @default("jogador")

  // Controla se a posição do jogador aparece na lista pública do ranking
  // (Ranking.jsx / GET /api/ranking). true = aparece pra todo mundo. Ele
  // sempre vê a própria posição real no Perfil, independente disso — só
  // afeta a visibilidade pros outros.
  rankingVisivel Boolean @default(true)

  // Id do gradiente de fundo escolhido pra tela de Perfil (ver
  // FUNDOS_PERFIL em frontend/src/data/fundosPerfil.js). "padrao" = fundo
  // branco padrão.
  fundoPerfil String @default("padrao")

  // Soft delete: quando preenchido, o usuário está "excluído". A linha
  // continua no banco (preserva Progresso/Personagem/Ranking já vinculados
  // a ele em vez de quebrar essas relações), mas some das leituras normais
  // — ver backend/src/config/prisma.js, que filtra deletedAt: null
  // automaticamente em toda query de Usuario. Null = usuário ativo.
  deletedAt DateTime?

  progresso      Progresso[]
  personagem     Personagem?
  bausMundo      BauMundo[]
  logsAdmin      LogAdmin[]
  loginHistorico LoginHistorico[]

  @@map("usuarios")
}

// Histórico de tentativas de login (sucesso e falha), pra auditoria de
// segurança no painel administrativo — ver auth.service.js::login (grava
// uma linha a cada tentativa, sucesso ou não) e
// loginHistorico.service.js::listarLoginHistorico (listagem com busca e
// paginação).
model LoginHistorico {
  id Int @id @default(autoincrement())

  // Nulo quando a tentativa falha com um e-mail que não corresponde a
  // nenhuma conta — não há usuário pra vincular, mas emailTentado guarda o
  // texto digitado mesmo assim, pra dar pra pesquisar.
  usuarioId Int?
  // "Retrato" do momento da tentativa (não um join) — mesmo motivo do
  // LogAdmin: se o usuário for renomeado depois, o histórico continua
  // mostrando o nome de então. Fica null quando o e-mail não bate com
  // nenhuma conta.
  nomeUsuario  String?
  emailTentado String

  sucesso Boolean
  // Motivo da falha (ex: "Senha incorreta", "E-mail não cadastrado",
  // "Conta desativada", "E-mail não verificado") — null quando sucesso = true.
  motivoFalha String?
  ip          String?
  userAgent   String?

  criadoEm DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([emailTentado])
  @@map("login_historico")
}

// Auditoria de toda alteração feita pelo painel de administração (editar
// desafio/recompensa, promover/remover admin, ativar/desativar conta) —
// ver log.service.js::registrarLog, chamado no fim de cada operação de
// escrita dos services de admin. Nunca é escrito nem lido pelo fluxo normal
// do jogo, só pelo painel.
model LogAdmin {
  id Int @id @default(autoincrement())

  // Quem fez a alteração. Nome e papel são um "retrato" do momento da ação
  // (não um join) — se o admin for renomeado ou rebaixado depois, o log
  // antigo continua contando a história como ela realmente aconteceu.
  usuarioId   Int
  nomeUsuario String
  role        String

  // Categoria da ação (ex: "desafio.atualizar", "usuario.role",
  // "usuario.ativo") e o registro afetado, pra poder filtrar o histórico.
  acao       String
  entidade   String
  entidadeId Int?

  // Texto pronto pra exibir na tela de logs, e o diff campo a campo (json
  // { campo: { de, para } }) pra quem quiser o detalhe exato.
  descricao  String?
  alteracoes Json?

  criadoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("logs_admin")
}

model Desafio {
  id Int @id @default(autoincrement())

  mundoId     Int
  // ids reais usados na rota (ver SelecionarDificuldade.jsx): "iniciante" | "guerreiro"
  dificuldade String
  // posição do desafio dentro da trilha (1 a 6) — é o :desafioId da URL,
  // não o "id" (PK) deste model. Ver mundoId_dificuldade_numero abaixo.
  numero      Int

  titulo    String
  enunciado String
  dica      String?

  // Json livre, no mesmo formato já usado em ResolverDesafio.jsx — hoje
  // guarda um de dois formatos, conforme o tipo do exercício:
  // - múltipla escolha: [{ id: "a", texto: "...", correta: true }, ...]
  // - ordenar blocos: { tipo: "ordenar_blocos", blocos: [{id, codigo}], ordemCorreta: [id, ...] }
  alternativas Json

  xpConcedido Int @default(10)

  // recompensa concedida ao vencer (ver frontend/src/data/recompensas.js —
  // esses 4 campos substituem aquele arquivo quando a API existir)
  tipoRecompensa      String? // "insignia" | "item"
  nomeRecompensa      String?
  descricaoRecompensa String?
  iconeRecompensa     String?

  // quando tipoRecompensa = "item", este é o Item real que entra no
  // inventário do personagem (via ItemPersonagem) na primeira vez que o
  // jogador conclui o desafio. "insignia" não tem Item associado — é só
  // um reconhecimento textual, não ocupa espaço no inventário.
  itemRecompensaId Int?
  itemRecompensa   Item? @relation(fields: [itemRecompensaId], references: [id])

  criadoEm DateTime @default(now())

  progresso Progresso[]

  // não pode haver dois desafios na mesma posição da mesma trilha
  @@unique([mundoId, dificuldade, numero])
  @@map("desafios")
}

model Progresso {
  id Int @id @default(autoincrement())

  usuarioId Int
  desafioId Int

  concluido     Boolean   @default(false)
  tentativas    Int       @default(0)
  xpGanho       Int       @default(0)
  dataConclusao DateTime?
  // Tempo (em segundos) que o jogador levou até acertar, gravado só na
  // conclusão (igual dataConclusao) — usado pro bônus de velocidade em
  // xpGanho (ver progresso.service.js::responderDesafio). Null em desafios
  // concluídos antes desse campo existir.
  tempoSegundos Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  desafio Desafio @relation(fields: [desafioId], references: [id])

  // cada usuário tem no máximo um registro de progresso por desafio
  @@unique([usuarioId, desafioId])
  @@map("progresso")
}

// ==== NOVO — a confirmar com a tela EditarPersonagem real ====

model Personagem {
  id Int @id @default(autoincrement())

  usuarioId Int @unique

  nome      String  @default("Guerreiro")
  nivel     Int     @default(1)
  vidaAtual Int     @default(100)
  vidaMax   Int     @default(100)
  imagemUrl String?

  criadoEm DateTime @default(now())

  usuario Usuario          @relation(fields: [usuarioId], references: [id])
  itens   ItemPersonagem[]

  @@map("personagens")
}

model Item {
  id Int @id @default(autoincrement())

  nome        String
  // slot de equipamento — bate com os ids dos slots em EditarPersonagem.jsx:
  // "capacete" | "peitoral" | "sapato" | "arma" | "costas" | "acessorios"
  tipo        String
  raridade    String  @default("comum") // "comum" | "raro" | "epico" | "lendario"
  descricao   String?
  // emoji mostrado em Perfil.jsx (itensDestaque) e nos slots de EditarPersonagem
  // quando o item está equipado — hoje as duas telas usam emoji, não imagem.
  icone       String?
  imagemUrl   String?
  bonusAtaque Int     @default(0)
  bonusDefesa Int     @default(0)

  personagens ItemPersonagem[]
  desafios    Desafio[] // desafios que dão este item como recompensa ao concluir
  baus        BauMundo[] // baús de fim de mundo que já sortearam este item

  @@map("itens")
}

// Baú de fim de mundo, liberado no mapa da Home quando o jogador conclui
// TODOS os desafios cadastrados de uma trilha. A existência da linha aqui
// É o "já abri esse baú" — trava um segundo sorteio pra mesma trilha.
model BauMundo {
  id Int @id @default(autoincrement())

  usuarioId   Int
  mundoId     Int
  dificuldade String

  // item sorteado na roleta e já creditado no inventário (ItemPersonagem)
  // no momento da abertura.
  itemGanhoId Int
  abertoEm    DateTime @default(now())

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  itemGanho Item    @relation(fields: [itemGanhoId], references: [id])

  // um usuário só abre o baú de cada trilha uma vez
  @@unique([usuarioId, mundoId, dificuldade])
  @@map("baus_mundo")
}

model ItemPersonagem {
  id Int @id @default(autoincrement())

  personagemId Int
  itemId       Int

  quantidade Int      @default(1)
  equipado   Boolean  @default(false)
  // Selecionado pelo jogador pra aparecer na seção "Itens em destaque" do
  // Perfil, independente de estar equipado ou não.
  destaque   Boolean  @default(false)
  obtidoEm   DateTime @default(now())

  personagem Personagem @relation(fields: [personagemId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@unique([personagemId, itemId])
  @@map("itens_personagem")
}
