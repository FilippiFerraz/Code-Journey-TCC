# ============================================================
# .env.example — modelo do .env do BACKEND (sem valores reais)
# Coloque em backend/.env.example
# Seus amigos copiam para backend/.env e preenchem com os valores deles.
# ============================================================

# Banco de dados (Neon PostgreSQL)
DATABASE_URL=

# JWT — segredo para assinar os tokens (invente uma string longa)
JWT_SECRET=

# E-mail (Gmail com App Password de 16 caracteres)
EMAIL_USER=
EMAIL_PASS=
