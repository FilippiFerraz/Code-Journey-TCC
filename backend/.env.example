# .env.example — modelo do .env do BACKEND (sem valores reais)
# Copie para backend/.env e preencha com os valores reais do seu ambiente.
# O .env de verdade nunca deve ser commitado (ver .gitignore).

# Banco de dados (Neon PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nome_do_banco?sslmode=require"

# JWT — segredo para assinar os tokens (invente uma string longa e aleatória)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

PORT=3333

# E-mail (Gmail com App Password de 16 caracteres)
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua-app-password-de-16-caracteres
