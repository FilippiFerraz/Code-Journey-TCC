# Modelo do backend/.env — copie para .env e preencha. Nunca commite o .env.

DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
JWT_SECRET=troque-por-um-segredo-longo
PORT=3333

# Endereço do frontend — só ele pode chamar a API pelo navegador (CORS).
# Mais de um: separe por vírgula. Sem essa variável, vale http://localhost:5173
# FRONTEND_URL=http://localhost:5173,https://seu-site.com

# E-mail usado para verificação de conta e recuperação de senha
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=senha-de-app-do-gmail

# Correção dos desafios dissertativos por IA (ver src/services/ia.service.js)
# "gemini" (tem plano gratuito) ou "claude" (pago por uso)
IA_PROVEDOR=gemini
# Chave do Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Opcional: modelo principal e reserva do Gemini (padrões: gemini-flash-lite-latest
# e gemini-flash-latest — apelidos que sempre apontam pro modelo mais novo)
# GEMINI_MODELO=gemini-flash-lite-latest
# GEMINI_MODELO_RESERVA=gemini-flash-latest

# Só se IA_PROVEDOR=claude — chave do console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-opus-5
